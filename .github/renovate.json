{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "automerge": false,
      "groupName": "Docker images"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^versions\\.json$"],
      "matchStrings": [
        "\"gotrue\":\\s*\"(?<depName>supabase/gotrue):(?<currentValue>[^\"]+)\"",
        "\"postgrest\":\\s*\"(?<depName>postgrest/postgrest):(?<currentValue>[^\"]+)\"",
        "\"storage\":\\s*\"(?<depName>supabase/storage-api):(?<currentValue>[^\"]+)\"",
        "\"imgproxy\":\\s*\"(?<depName>darthsim/imgproxy):(?<currentValue>[^\"]+)\"",
        "\"postgres\":\\s*\"(?<depName>supabase/postgres):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
