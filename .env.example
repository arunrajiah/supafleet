############################################################
# Supabase Multi-DB — Global Configuration
# Copy to .env and fill in real values before first boot.
# Generate secrets: openssl rand -base64 32
############################################################

# ── Postgres ────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-super-secret-postgres-password
POSTGRES_PORT=5432

# ── JWT (used for the default/admin database only) ──────
# Per-tenant JWT secrets are generated automatically by add-tenant.sh
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
JWT_EXPIRY=3600

# ── Domain ──────────────────────────────────────────────
# Tenants will be reachable at <tenant-name>.<DOMAIN>
# Example: myapp.example.com
DOMAIN=example.com

# ── SMTP (shared by all tenants for auth emails) ────────
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase
ENABLE_EMAIL_AUTOCONFIRM=false
